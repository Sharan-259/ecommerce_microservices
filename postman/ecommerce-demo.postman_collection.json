{
  "info": {
    "name": "Ecommerce Price + Tax Services (demo)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Price Service :8083 and Tax Service :8084. Demo data only."
  },
  "item": [
    {
      "name": "PRICE SERVICE (:8083)",
      "item": [
        {
          "name": "01 GET current price BOS-001",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8083/api/v1/prices/BOS-001"
            },
            "description": "Expect 200. Seeded v1: selling price 6999.00 (synthetic demo price)."
          }
        },
        {
          "name": "02 GET price on date (before first version)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8083/api/v1/prices/BOS-001?date=2026-09-30"
            },
            "description": "Expect 404 PRICE_NOT_FOUND - no price valid before 2026-10-01."
          }
        },
        {
          "name": "03 GET price history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8083/api/v1/prices/BOS-001/history"
            },
            "description": "Expect one version (v1) on a fresh database."
          }
        },
        {
          "name": "04 POST new price (creates version 2)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "http://localhost:8083/api/v1/prices"
            },
            "description": "Expect 201, priceVersion 2. Run only once per fresh database (second run -> 409).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"BOS-001\",\n  \"currency\": \"INR\",\n  \"basePrice\": 7999.0,\n  \"sellingPrice\": 7199.1,\n  \"discountPercent\": 10.0,\n  \"validFrom\": \"2026-10-03\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
